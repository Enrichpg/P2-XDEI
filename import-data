#
# Register Weather Context Providers for all 4 Stores
#
for STORE_ID in 001 002 003 004; do
  curl -s -o /dev/null -X POST \
    http://orion:1026/v2/registrations \
    -H 'Content-Type: application/json' \
    -d "{
     \"description\": \"Weather Conditions Store:${STORE_ID}\",
     \"dataProvided\": {
       \"entities\": [{\"id\": \"urn:ngsi-ld:Store:${STORE_ID}\",\"type\": \"Store\"}],
       \"attrs\": [\"temperature\", \"relativeHumidity\"]
     },
     \"provider\": {
       \"http\": {\"url\": \"http://tutorial:3000/proxy/v1/random/weatherConditions\"},
       \"legacyForwarding\": true
     },
     \"status\": \"active\"
  }"
done

